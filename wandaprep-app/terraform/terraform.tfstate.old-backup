            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"sts:AssumeRoleWithWebIdentity\",\n      \"Principal\": {\n        \"Federated\": \"arn:aws:iam::211125430491:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/A6D6762702C330482FB7FDA7D80A489E\"\n      },\n      \"Condition\": {\n        \"StringEquals\": {\n          \"oidc.eks.us-east-1.amazonaws.com/id/A6D6762702C330482FB7FDA7D80A489E:aud\": \"sts.amazonaws.com\",\n          \"oidc.eks.us-east-1.amazonaws.com/id/A6D6762702C330482FB7FDA7D80A489E:sub\": \"system:serviceaccount:kube-system:aws-load-balancer-controller\"\n        }\n      }\n    }\n  ]\n}",
            "minified_json": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"sts:AssumeRoleWithWebIdentity\",\"Principal\":{\"Federated\":\"arn:aws:iam::211125430491:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/A6D6762702C330482FB7FDA7D80A489E\"},\"Condition\":{\"StringEquals\":{\"oidc.eks.us-east-1.amazonaws.com/id/A6D6762702C330482FB7FDA7D80A489E:aud\":\"sts.amazonaws.com\",\"oidc.eks.us-east-1.amazonaws.com/id/A6D6762702C330482FB7FDA7D80A489E:sub\":\"system:serviceaccount:kube-system:aws-load-balancer-controller\"}}}]}",
